# Zabbix AGENT configuration — the default env, lives on EACH monitored host.
# Copy and edit, then start the agent (Compose auto-loads .env — no flag needed):
#   cp .env.example .env
#   docker compose up -d
#
# No secrets here — safe to ship to every monitored host.
# (The server stack uses its own .env.server via --env-file; see .env.server.example.)

# Zabbix image tag (match the server's major.minor version)
ZBX_IMAGE_TAG=alpine-7.4-latest

# Zabbix server address, reachable on port 10051 FROM this host (IP or DNS).
# Same value on every monitored host. Prefer a DNS name in production.
ZBX_SERVER_HOST=zabbix.example.com

# Leave empty to auto-use this machine's system hostname (recommended for a fleet).
ZBX_HOSTNAME=

# Autoregistration tag matched by the server's autoregistration action.
ZBX_METADATA=linux
