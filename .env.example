# Copy to .env and change secrets before first start:
#   cp .env.example .env

# Zabbix image tag (official: alpine-<version>-latest)
ZBX_IMAGE_TAG=alpine-7.4-latest

# PostgreSQL
POSTGRES_IMAGE_TAG=17-alpine
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=zabbix

# Published ports (bind on all interfaces for remote agents)
ZABBIX_SERVER_PORT=10051
ZABBIX_WEB_PORT=8051

# Shown in the web UI title bar
ZABBIX_SERVER_NAME=Zabbix monitoring

# Web UI timezone (PHP)
TZ=UTC

# Host dir for custom alert/external scripts (read-only bind mounts).
# The database uses a Docker named volume, not this path.
DATA_DIRECTORY=./data

# --- Agent (only used by docker-compose.agent.yml) ---
# Address of the Zabbix server, reachable on port 10051 FROM this host (IP or DNS).
# Same value on every monitored host (it's the central server's address).
ZBX_SERVER_HOST=10.0.0.5
# Leave ZBX_HOSTNAME empty to auto-use this machine's system hostname (recommended
# for a fleet). Set it only if you want to override the name for this host.
ZBX_HOSTNAME=
# Autoregistration tag the server's action matches on (keep "linux" unless you
# build per-role actions, e.g. "linux web", "linux db").
ZBX_METADATA=linux
